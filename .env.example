VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Só para desenvolvimento local, antes de a tabela profiles/is_admin() existir na Supabase.
# NUNCA definir como true em produção — salta a verificação de is_admin().
VITE_DEV_BYPASS_AUTH=false

# Usadas pelas funções serverless em api/ (correm no servidor do Vercel, nunca no
# browser) — por isso SEM o prefixo VITE_. Definir em Vercel → Project Settings →
# Environment Variables, nunca num ficheiro .env commitado.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
